[Unit]
Description=Miraki Gardens Reviews API
After=network.target postgresql.service

[Service]
Type=simple
User=miraki-reviews
WorkingDirectory=/opt/miraki-reviews
EnvironmentFile=/etc/miraki-reviews.env
ExecStart=/usr/bin/node /opt/miraki-reviews/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/miraki-reviews

[Install]
WantedBy=multi-user.target

